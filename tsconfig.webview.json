{
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "node",
		"target": "ES2020",
		"lib": [
			"ES2020",
			"DOM",
			"DOM.Iterable"
		],
		"jsx": "react-jsx",
		"strict": false,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": false
	},
	"include": [
		"src/webview-api/**/*"
	]
}
